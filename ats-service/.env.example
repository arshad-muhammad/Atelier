# Atelier ATS Service Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# BGE Embedding Model Configuration
# Can be swapped to BAAI/bge-base-en-v1.5 or BAAI/bge-m3
ATS_MODEL_NAME=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=./models_cache
ATS_DEVICE=cpu

# Authentication Secret (shared with Next.js server)
ATS_API_KEY=atelier-ats-production-key-2026

# Scoring Weights (sums to 100)
WEIGHT_KEYWORD_MATCH=35.0
WEIGHT_SEMANTIC_RELEVANCE=25.0
WEIGHT_REQUIRED_SKILLS=20.0
WEIGHT_STRUCTURE=10.0
WEIGHT_FORMATTING=5.0
WEIGHT_CONTACT=5.0

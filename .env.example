# ─────────────────────────────────────────────────────────────
# Atelier Platform Environment Configuration
# ─────────────────────────────────────────────────────────────

# ── 1. Application & Domain URLs ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://atelier.spherehive.com

# ── 2. MySQL Database Configuration ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atelier

# ── 3. Telegram Bot API Storage (Server-side only; NEVER expose to client) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=

# ── 4. Session & Mentor JWT Security ──
# 32+ character random secret for signing mentor JWT session tokens
SESSION_SECRET=atelier-production-session-secret-change-this-in-prod-2026

# ── 5. Admin Console Clearance Credentials (Optional overrides) ──
# Defaults in codebase: Key="ARSHAD-SAMVRUDHI", Password="noor"
NEXT_PUBLIC_MASTER_SECURITY_KEY=ARSHAD-SAMVRUDHI
NEXT_PUBLIC_CLEARANCE_PASSWORD=noor

# ── 6. Razorpay Payment Gateway ──
# Get these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── 7. Google OAuth 2.0 (Student Social Sign-in) ──
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 8. GitHub OAuth App (Student Social Sign-in) ──
# GitHub Settings: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 9. MojoAuth Email OTP Authentication ──
# MojoAuth Dashboard: https://mojoauth.com
MOJOAUTH_API_KEY=
MOJOAUTH_API_SECRET=

# ── 10. Dedicated ATS Resume Analyzer Service ──
# Standalone FastAPI Python service running BAAI/bge-small-en-v1.5 locally
ATS_SERVICE_URL=http://127.0.0.1:8000
ATS_API_KEY=atelier-ats-production-key-2026

